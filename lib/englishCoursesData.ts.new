        vocabularyKeywords: ["First name", "Last name", "Occupation", "Colleague"],
        explanation: "Uso del verbo 'To Be' para presentaciones. Las contracciones son comunes en habla informal.",
        dialogue: [
          { speaker: "A", text: "Hi, I'm Sarah.", translation: "Hola, soy Sarah." },
          { speaker: "B", text: "Hello Sarah, I'm John.", translation: "Hola Sarah, soy John." }
