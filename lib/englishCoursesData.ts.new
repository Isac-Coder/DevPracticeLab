        interactiveDrill: {
          question: "¿Cuál es la forma correcta?",
          options: ["I am Sarah.", "I is Sarah.", "I are Sarah.", "I Sarah."],
          correctAnswer: "I am Sarah.",
          explanation: "La primera persona singular usa 'am'."
        }
      },
      // Units for 2-14... (omitted for brevity, will fill all)
    ]
